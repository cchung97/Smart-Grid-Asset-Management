# Postgres (container bootstrap — consumed by the `db` service image directly)
POSTGRES_USER=grid
POSTGRES_PASSWORD=grid
POSTGRES_DB=grid_assets
POSTGRES_PORT=5432

# Backend's own DB connection (used by the `backend` and `migrate`
# services) — kept as discrete fields, not one DATABASE_URL, so each is
# legible and a password never needs URL-escaping. Keep these in sync
# with the POSTGRES_* values above.
DB_HOST=db
DB_PORT=5432
DB_USER=grid
DB_PASSWORD=grid
DB_NAME=grid_assets
DB_SSLMODE=disable

# Backend
BACKEND_PORT=8080
# Shared secret. Every /api endpoint requires it (x-api-key header only); /healthz and
# the Swagger docs are open. The frontend's nginx (and the Vite dev proxy) add this key
# to every /api request themselves, so users never type it and it never reaches the
# browser. With no key set, every /api call is refused (403). Keep it free of
# quotes and $ (nginx puts it in a config file): `openssl rand -hex 32` is safe.
# Generate your own: openssl rand -hex 32
API_KEY=replace-with-your-own-generated-key
# Comma-separated allowed origins for CORS; empty = allow any origin
# (fine here — no cookies/credentials anywhere in this app).
CORS_ALLOWED_ORIGINS=
# Largest accepted request body in bytes — this is also the CSV upload size
# limit. Default 10485760 (10 MiB) when unset.
MAX_REQUEST_BYTES=10485760

# Frontend
FRONTEND_PORT=8081
